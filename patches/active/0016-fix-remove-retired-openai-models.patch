diff --git a/packages/ai/scripts/model-data.ts b/packages/ai/scripts/model-data.ts
index 588bc6956897c1ac94bb95d82cafa7915c7b5084..6e3bc5c6054792e0f529ff727c2353a8bcd5d6d1 100644
--- a/packages/ai/scripts/model-data.ts
+++ b/packages/ai/scripts/model-data.ts
@@ -109,6 +109,33 @@ export function readModelDataStructure(packageRoot: string): ModelDataStructure
 	);
 }
 
+export function hydrateModelDataStructure<T extends { api: string }>(
+	structure: ModelDataStructure,
+	generatedProviders: Record<string, Record<string, T> | undefined>,
+): Record<string, Record<string, T>> {
+	const hydratedProviders: Record<string, Record<string, T>> = {};
+	const hydrationErrors: string[] = [];
+	for (const [providerId, expectedModels] of Object.entries(structure)) {
+		hydratedProviders[providerId] = {};
+		for (const [modelId, expectedApi] of Object.entries(expectedModels)) {
+			const model = generatedProviders[providerId]?.[modelId];
+			if (!model) {
+				hydrationErrors.push(`missing ${providerId}/${modelId}`);
+				continue;
+			}
+			if (model.api !== expectedApi) {
+				hydrationErrors.push(`${providerId}/${modelId} uses ${model.api}, expected ${expectedApi}`);
+				continue;
+			}
+			hydratedProviders[providerId][modelId] = model;
+		}
+	}
+	if (hydrationErrors.length > 0) {
+		throw new Error(`Cannot hydrate the committed model catalog:\n${hydrationErrors.map((error) => `  - ${error}`).join("\n")}`);
+	}
+	return hydratedProviders;
+}
+
 export function modelDataStructureHash(structure: ModelDataStructure): string {
 	return sha256(JSON.stringify(structure));
 }
